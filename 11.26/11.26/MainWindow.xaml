<Window x:Class="_11._26_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_11._26_"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="textbox" Grid.Row="0" FontSize="40" IsReadOnly="True" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Height="70"/>

        <Button x:Name="button" Content="Nyomd meg" FontSize="30" Grid.Row="2" Click="button_Click"/>
    </Grid>
</Window>
